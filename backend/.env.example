# Server Configuration
PORT=4000
NODE_ENV=development

# Allowed CORS Origins (Comma-separated list, including web frontend and Android Capacitor origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,capacitor://localhost,https://localhost

# Merchant Static QRIS String (EMVCo format from your bank/e-wallet merchant dashboard)
# Dev dummy payload (for local testing):
STATIC_QRIS_PAYLOAD=00020101021126580014ID.LINKAJA.WWW01189360091430000000000208123456780303UMI51440014ID.DANA.WWW01189360091530000000000208123456780303UMI5204581253033605802ID5916DIZZ BAKED GOODS6007JAKARTA61051234062070703A0163044F2A

# Storage Directory (Relative or Absolute path)
STORAGE_DIR=./storage

# Order Expiration in Minutes (TTL for unpaid reservations and unique code recycling)
ORDER_EXPIRY_MINUTES=30
